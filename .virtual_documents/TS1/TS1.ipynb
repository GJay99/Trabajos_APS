





import numpy as np
from scipy.fft import fft, fftfreq
import matplotlib.pyplot as plt
from scipy.signal import square


N = 1000    # Muestras


def mi_funcion_seno(vmax = 1, dc = 0, ff = 1, ph = 0, nn = N, fs = 1000):
    tt=np.zeros(nn)
    xx=np.zeros(nn)
    for n in np.arange(0,nn,1):
        tt[n]= n * (1/fs)
        xx[n]= vmax * np.sin(2*np.pi*ff * tt[n] + ph) + dc
    return tt, xx


fs = 20000
t1,x1 = mi_funcion_seno(ff=2000,fs=fs)

plt.figure(1)
plt.plot(t1[:11], x1[:11], ":.")
plt.title("Seno ff=2 kHz")
plt.xlabel("tiempo [s]")
plt.ylabel("voltaje [V]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


x1_fft = fft(x1)
x1_fft = x1_fft[:N//2]

freq = fftfreq(N,1/fs)
freq = freq[:N//2]

x1_fft_abs = np.abs(x1_fft)

plt.figure(2)
plt.plot(freq,x1_fft_abs,":.")
plt.title("Modulo FFT seno")
plt.ylabel("|X|")
plt.xlabel("frecuencia [Hz]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


pot_deseada = 2
vmax = np.sqrt(2*pot_deseada)

t2,x2 = mi_funcion_seno(vmax=vmax,ff=2000,ph=np.pi/2,fs=fs)

pot_x2 = np.var(x2)
print(pot_x2)


plt.figure(3)
plt.plot(t2[:11], x2[:11], ":.")
plt.title("Seno ff=2 kHz, potencia = 2W y phi = pi/2´")
plt.xlabel("tiempo [s]")
plt.ylabel("voltaje [V]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


x2_fft = fft(x2)
x2_fft = x2_fft[:N//2]

x2_fft_abs = np.abs(x2_fft)

plt.figure(4)
plt.plot(freq,x2_fft_abs,":.")
plt.title("Modulo FFT seno")
plt.ylabel("|X|")
plt.xlabel("frecuencia [Hz]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


t3 = t1
x3 = np.random.normal(scale=np.sqrt(0.1),size=len(t3))

pot_x3 = np.var(x3)
print(pot_x3)


plt.figure(5)
plt.hist(x3)
plt.title("Histograma del ruido normal")
plt.xlabel("Amplitud [V]")
plt.ylabel("Cantidad de muestras")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


x3_fft = fft(x3)
x3_fft = x3_fft[:N//2]

x3_fft_abs = np.abs(x3_fft)

plt.figure(6)
plt.plot(freq,x3_fft_abs,":.")
plt.title("Modulo FFT ruido normal")
plt.ylabel("|X|")
plt.xlabel("frecuencia [Hz]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


t4 = t1
x4 = np.random.uniform(low=-np.sqrt(1.2)/2,high=np.sqrt(1.2)/2,size=len(t4))

pot_x4 = np.var(x4)
print(pot_x4)


plt.figure(7)
plt.hist(x4)
plt.title("Histograma del ruido uniforme")
plt.xlabel("Amplitud [V]")
plt.ylabel("Cantidad de muestras")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


x4_fft = fft(x4)
x4_fft = x4_fft[:N//2]

x4_fft_abs = np.abs(x4_fft)

plt.figure(8)
plt.plot(freq,x4_fft_abs,":.")
plt.title("Modulo FFT ruido uniforme")
plt.ylabel("|X|")
plt.xlabel("frecuencia [Hz]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


t5 = t1
x5 = (square(2*np.pi*2000*t5,duty=0.5)+1)*np.sqrt(2)/2

pot_x5 = np.mean(x5**2)

print(pot_x5)


plt.figure(9)
plt.plot(t5[:11], x5[:11], ":.")
plt.title("Señal cuadrada potencia 1W y frecuencia 2kHz")
plt.xlabel("tiempo [s]")
plt.ylabel("voltaje [V]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)


x5_fft = fft(x5)
x5_fft = x5_fft[:N//2]

x5_fft_abs = np.abs(x5_fft)

plt.figure(10)
plt.plot(freq,x5_fft_abs,":.")
plt.title("Modulo FFT señal cuadrada")
plt.ylabel("|X|")
plt.xlabel("frecuencia [Hz]")
plt.grid()
plt.axhline(0,color="black")
plt.axvline(0,color="black",linewidth=1)



